{
  "name": "app-de-garay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run --project shared --project api --project web",
    "test:watch": "vitest --project shared --project api --project web",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:types": "supabase gen types typescript --schema public > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test:integration": "vitest run --project integracion",
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w @garay/api\" \"npm run dev -w @garay/web\"",
    "build": "npm run build -w @garay/web",
    "start": "npm run build && npm run start -w @garay/api",
    "capturas": "node -e \"process.env.CAPTURAS='1';require('child_process').execSync('npx playwright test capturas --project=escritorio',{stdio:'inherit'})\"",
    "dev:prod": "concurrently -k -n api,web -c red,red \"npm run dev:prod -w @garay/api\" \"npm run dev:prod -w @garay/web\"",
    "vercel-build": "node scripts/vercel-build.mjs",
    "vercel-build:probar": "npm run vercel-build && node --env-file=.env.local scripts/probar-funcion.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@supabase/supabase-js": "^2.109.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "concurrently": "^10.0.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2"
  }
}
