{
  "name": "@garay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=../../.env.local --import tsx src/server.ts --solo-api",
    "dev:prod": "node --watch --env-file=../../.env.production --import tsx src/server.ts --solo-api",
    "start": "tsx --env-file=../../.env.local src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@garay/shared": "*",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@supabase/supabase-js": "^2.109.0",
    "hono": "^4.13.18",
    "nodemailer": "^7.0.13",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15"
  },
  "exports": {
    ".": "./src/app.ts"
  }
}
