# Backend apuntando a Supabase LOCAL (npx supabase start).
# Copiar a backend/.env.local y completar con la salida de: npx supabase status
# Correr con: npm run dev (las claves de producción van en .env.production,
# que sólo usa npm run dev:prod).
SUPABASE_URL=http://127.0.0.1:54321
# Las dos claves son las de la base LOCAL, no las del dashboard de supabase.com.
# "Publishable" de `npx supabase status` (empieza con sb_publishable_)
SUPABASE_KEY=
# "Secret" de `npx supabase status` (empieza con sb_secret_). Nunca la de producción acá.
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
# Mails (avisos de solicitudes) a Mailpit: se ven en http://127.0.0.1:54324.
# Los códigos de login los manda Supabase Auth, que ya usa Mailpit solo.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
MAIL_FROM=Oratorio de Garay <no-responder@local.test>
APP_URL=http://localhost:3000
