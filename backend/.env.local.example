# Backend apuntando a Supabase LOCAL (npx supabase start).
# Copiar a backend/.env.local y completar con la salida de: npx supabase status
# Correr con: npm run dev:local
SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" de supabase status
SUPABASE_KEY=
# "Secret key" de supabase status (sólo local; nunca la de producción acá)
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
