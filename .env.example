# Supabase Configuration
# Get these values from your Supabase project settings (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# Backend (for local development)
BACKEND_URL=http://localhost:3000

# Frontend (for production deployment on Vercel)
REACT_APP_API_URL=https://your-backend.vercel.app

# Service role key (Settings > API > service_role) - SECRET, backend only.
# Used to verify Google SSO sessions and check the allowed_emails table.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
